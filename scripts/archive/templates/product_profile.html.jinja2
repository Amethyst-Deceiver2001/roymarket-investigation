<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ display_name }} — product profile — РОЙ.МАРКЕТ</title>
<link rel="stylesheet" href="../../assets/profile.css">
</head><body>
<div class="wrap">

  <header class="mast">
    <button id="theme-toggle" type="button" aria-pressed="false" style="float:right;background:var(--panel-2);color:var(--ink);border:1px solid var(--rule);border-radius:6px;padding:.35em .7em;font:inherit;font-size:.85em;cursor:pointer;">☾/☀ theme</button>
    <p class="kicker">Product profile · РОЙ.МАРКЕТ investigation</p>
    <div class="profile-head-text">
      <h1>{{ display_name }}</h1>
      {% if name_ru and name_ru != display_name %}<span class="name-ru">{{ name_ru }}</span>{% endif %}
      <div class="chip-row">
        {% for chip in chips %}<span class="tag {{ chip.cls }}">{{ chip.label }}</span>{% endfor %}
      </div>
    </div>
  </header>

  <section id="supply-chain">
    <p class="eyebrow">Supply chain</p>
    <ul class="plain">
      {% for link in supply_chain %}
      <li><strong>{{ link.role }}</strong> —
        {% if link.profile_url %}<a href="{{ link.profile_url }}">{{ link.label }}</a>{% else %}{{ link.label }}{% endif %}
        {% if link.note %}<br>{{ link.note }}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  {% if description %}
  <section id="description">
    <p class="eyebrow">Description</p>
    {% for d in description %}
    <p><strong>{{ d.name }}:</strong> {{ d.text }} {% if d.source %}<span class="id">[{{ d.source }}]</span>{% endif %}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if specs %}
  <section id="specs">
    <p class="eyebrow">Specifications</p>
    <div class="meta-grid">
      {% for s in specs %}
      <div><dt>{{ s.label }}</dt><dd>{{ s.value }}</dd></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if images_gallery %}
  <section id="images">
    <p class="eyebrow">Visuals</p>
    <div class="gallery">
      {% for img in images_gallery %}
      <figure><img src="{{ img.url }}" alt="{{ img.caption or display_name }}">
        <figcaption>{{ img.caption or "" }}{% if img.source %}<span class="src">{{ img.source }}</span>{% endif %}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if field_testing %}
  <section id="field-testing">
    <p class="eyebrow">Field testing &amp; battlefield evidence</p>
    {% for b in field_testing %}
    <blockquote>{{ b.en }}
      <cite>{{ b.context or "" }} {% if b.as_of %}— {{ b.as_of }}{% endif %} {% if b.source %}<span class="id">[{{ b.source }}]</span>{% endif %}</cite>
    </blockquote>
    {% if b.image_url %}
    <div class="gallery"><figure><img src="{{ b.image_url }}" alt="{{ b.context or 'Field evidence photo' }}"><figcaption>{{ b.context or "" }}<span class="src">{{ b.as_of or "" }}{% if b.source %} — {{ b.source }}{% endif %}</span></figcaption></figure></div>
    {% endif %}
    {% endfor %}
  </section>
  {% endif %}

  {% if related_entities %}
  <section id="related">
    <p class="eyebrow">Network context</p>
    <ul class="plain">
      {% for r in related_entities %}
      <li>{% if r.profile_url %}<a href="{{ r.profile_url }}">{{ r.label }}</a>{% else %}<strong>{{ r.label }}</strong>{% endif %}
        {% if r.relationship_type %}<span class="tag t-open">{{ r.relationship_type }}</span>{% endif %}
        — via {{ r.via }}: {{ r.relationship }} {% if r.source %}<span class="id">[{{ r.source }}]</span>{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if handovers %}
  <section id="handovers">
    <p class="eyebrow">Handovers to government customers / units</p>
    <div class="scroll"><table>
      <thead><tr><th>Customer</th><th>Date</th><th>Note</th><th>Source</th></tr></thead>
      <tbody>
        {% for h in handovers %}
        <tr><td>{{ h.customer or "—" }}</td><td class="num">{{ h.date or "—" }}</td><td>{{ h.note or "" }}</td><td>{% if h.source %}<span class="id">[{{ h.source }}]</span>{% endif %}</td></tr>
        {% endfor %}
      </tbody>
    </table></div>
  </section>
  {% endif %}

  {% if not_yet_sourced %}
  <section id="gaps">
    <p class="eyebrow">Not yet sourced</p>
    <ul class="plain">
      {% for g in not_yet_sourced %}<li>{{ g }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer>
    <p class="eyebrow">Sources cited</p>
    <div class="scroll"><table>
      <thead><tr><th>ID</th><th>Type</th><th>Locator</th><th>Captured</th><th>As of</th></tr></thead>
      <tbody>
        {% for s in sources_table %}
        <tr><td>{{ s.id }}</td><td>{{ s.type }}</td>
          <td>{% if s.url %}<a href="{{ s.url }}">{{ s.locator }}</a>{% else %}{{ s.locator }}{% endif %}</td>
          <td class="num">{{ s.captured_date or "—" }}</td><td class="num">{{ s.as_of or "—" }}</td></tr>
        {% endfor %}
      </tbody>
    </table></div>
    <p class="footnote">Generated by scripts/build_product_profile.py from data/registry/entities.json. Not
      hand-edited — corrections go through corrections_entities.json.</p>
  </footer>

</div>
<script>
(function(){
  var root = document.documentElement;
  var btn = document.getElementById('theme-toggle');
  var stored = null;
  try { stored = localStorage.getItem('roymarket-theme'); } catch (e) {}
  function apply(theme) {
    if (theme === 'dark' || theme === 'light') { root.setAttribute('data-theme', theme); }
    else { root.removeAttribute('data-theme'); }
    if (btn) btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  }
  apply(stored);
  if (btn) {
    btn.addEventListener('click', function () {
      var current = root.getAttribute('data-theme');
      var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      var currentlyDark = current === 'dark' || (!current && systemDark);
      var next = currentlyDark ? 'light' : 'dark';
      apply(next);
      try { localStorage.setItem('roymarket-theme', next); } catch (e) {}
    });
  }
})();
</script>
</body></html>
