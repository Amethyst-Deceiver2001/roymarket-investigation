#!/bin/sh
# Keeps data/watch/status/board.json current with every registry-fact commit,
# not just the 09:15 daily round, so pending items can be worked and cleared
# methodically between rounds (user, 04.10.2026).
#
# Install once: git config core.hooksPath ops/git-hooks
#
# Fires only when a commit touches a fact file (entities/people/products/
# programs/military_units or either corrections file). Registry-only
# mechanical commits (sources.json after a pull, graph rebuilds with no
# fact change) are untouched -- status_board.py is cheap and idempotent,
# but there is no reason to run it on, say, a notes/-only commit.

set -e
cd "$(git rev-parse --show-toplevel)"

# Syntax parity with CI (user, 08.10.2026). The checks workflow runs Python 3.11 and the Mac runs a newer
# one, so 3.12-only syntax (a backslash or a reused quote inside an f-string expression) passes here and
# fails there: 14 pushes went red on one such line before anyone looked. Byte-compile every staged .py
# file with 3.11; install it once with `brew install python@3.11`. Without it the check is skipped loudly.
PY311=$(command -v python3.11 || ls /opt/homebrew/bin/python3.11 /usr/local/bin/python3.11 2>/dev/null | head -1 || true)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  if [ -z "$PY311" ]; then
    echo "pre-commit: WARNING python3.11 not found, so the CI syntax check is skipped (brew install python@3.11)"
  else
    for f in $STAGED_PY; do
      if ! "$PY311" - "$f" <<'PYEOF'
import sys
src = open(sys.argv[1], encoding="utf-8").read()
compile(src, sys.argv[1], "exec")
PYEOF
      then
        echo "pre-commit: $f does not compile on Python 3.11 (the version CI uses) -- commit blocked"
        exit 1
      fi
    done
  fi
fi

FACT_FILES='^data/registry/(entities|people|products|programs|military_units|corrections_entities|corrections_people)\.json$'
if ! git diff --cached --name-only | grep -qE "$FACT_FILES"; then
  exit 0
fi

echo "pre-commit: registry facts changed -- checking and refreshing the status board"

# check_registry.py's own exit code is the error signal (1 if any error,
# 0 otherwise -- scripts/check_registry.py's main() returns this directly).
# An earlier version of this hook believed it "always exits 0" and parsed
# its stdout instead, under `set -e`: that made the diagnostic branch dead
# code on the exact path it existed for, since `set -e` killed the script
# at the check_registry.py line before the grep/echo/tail ever ran -- the
# commit still got blocked (git saw the hook's own nonzero exit), just with
# no printed reason (found 05.10.2026 by an adversarial code review).
if ! python3 scripts/check_registry.py >/tmp/pre-commit-check_registry.log 2>&1; then
  echo "pre-commit: check_registry.py reports errors -- commit blocked"
  tail -40 /tmp/pre-commit-check_registry.log
  exit 1
fi

cp data/watch/status/board.json /tmp/pre-commit-board-prev.json 2>/dev/null || true
if [ -f /tmp/pre-commit-board-prev.json ]; then
  python3 scripts/status_board.py --diff /tmp/pre-commit-board-prev.json --json data/watch/status/board.json >/tmp/pre-commit-board-diff.log 2>&1
  tail -20 /tmp/pre-commit-board-diff.log
else
  python3 scripts/status_board.py --json data/watch/status/board.json >/tmp/pre-commit-board.log 2>&1
fi
git add data/watch/status/board.json
echo "pre-commit: board.json refreshed and staged"
