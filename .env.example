# Copy to .env and fill in. Get TG_API_ID/TG_API_HASH from https://my.telegram.org
# (a fresh app registration is fine — doesn't need to match wb_watch's).
# TG_SESSION is printed by `python3 scripts/tg_login.py` after a one-time
# interactive login (phone + code, + 2FA if enabled).
TG_API_ID=
TG_API_HASH=
TG_SESSION=
